# ─── AI Service (FastAPI) Environment Variables ──────────────────────────────
# Server bind address and port
HOST=0.0.0.0
PORT=8000

# ─── YOLO Object Detection ──────────────────────────────────────────────────
# Path to YOLOv8 model weights (relative to ai-service directory)
YOLO_MODEL=yolov8n.pt

# ─── Tesseract OCR ──────────────────────────────────────────────────────────
# Path to Tesseract binary (leave empty to auto-detect)
# Linux/Mac: tesseract   |   Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=tesseract

# Tesseract languages (e.g., eng, ara, eng+ara)
OCR_LANGUAGES=eng+ara

# ─── Upload Limits ──────────────────────────────────────────────────────────
# Maximum upload size in MB (enforced by middleware)
MAX_UPLOAD_MB=5

# ─── CORS ───────────────────────────────────────────────────────────────────
# Frontend URL for CORS whitelist
FRONTEND_URL=http://localhost:3000

# Backend URL for CORS whitelist
BACKEND_URL=http://localhost:5000

# ─── Gemini (used by scene_service.py) ──────────────────────────────────────
# Google Gemini API key — required for scene descriptions
GEMINI_API_KEY=your_gemini_api_key_here
