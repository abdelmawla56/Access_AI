# ─── Backend (Express) Environment Variables ─────────────────────────────────
# Port the Express server listens on
PORT=5000

# Frontend origin for CORS whitelist
FRONTEND_URL=http://localhost:3000

# AI service base URL (FastAPI)
AI_SERVICE_URL=http://localhost:8000

# Maximum upload file size (in MB) — applied to Express body parser
MAX_FILE_SIZE_MB=5

# ─── Gemini AI Assistant ─────────────────────────────────────────────────────
# Google Gemini API key — required for /api/assistant/chat
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Rate Limiting ───────────────────────────────────────────────────────────
# Global rate limit: max requests per window (default: 100 per 15 min)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# AI-specific rate limit: max requests per window (default: 10 per 1 min)
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=10

# ─── Email (Optional — for emergency contact alerts) ─────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# ─── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development
